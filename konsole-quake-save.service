[Unit]
Description=Best-effort save of Konsole-Quake state when the graphical session stops
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=/bin/bash -c 'if [ -f /tmp/konsole-quake.pid ]; then /usr/bin/python3 "@SCRIPT_DIR@/konsole-quake-session.py" save; fi'
TimeoutStopSec=30

[Install]
WantedBy=graphical-session.target
